VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# ---- 仅服务端可见 ----
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# 服务端管理操作（绕过 RLS，绝不可暴露给前端）
SUPABASE_SERVICE_ROLE_KEY=

# AI 目标拆解所需的模型网关密钥
LOVABLE_API_KEY=
